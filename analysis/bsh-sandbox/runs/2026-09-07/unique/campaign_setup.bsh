import com.gad.sdk.viewmodel.GadViewModel;

    AppCompatActivity action;
    Handler hold;
    GadViewModel medal;

    private void execute(Runnable runnable) {
        hold.post(runnable);
    }

    public void destroy() {
        action = null;
        if (hold != null) {
            hold.removeCallbacksAndMessages(null);
        }
        hold = null;
    }

