import android.content.*;
import android.net.Uri;
import android.os.Handler;
import android.util.Log;
import android.view.View;
import android.webkit.WebView;
import android.widget.Toast;
import androidx.appcompat.app.AlertDialog;
import com.gad.sdk.model.Advertisement;
import com.gad.sdk.ui.fragment.GadPerformFragment;
import com.gad.sdk.viewmodel.GadPerformViewModel;

    Context cat;
    WebView wind;
    WebView hawaii;
    Handler hold;
    Advertisement apple;
    GadPerformViewModel vibe;
    GadPerformFragment flag;
    AlertDialog mDialog;
    SharedPreferences mPref;

    boolean isAdded;
    boolean isSignInRequested;

    boolean USE_API = false;

    // 초기화 함수로 멤버변수가 설정된 후 호출된다. true 리턴시 광고 url을 로딩하지 않는다.
    public boolean prepare() {
        mPref = cat.getSharedPreferences("com.gad.sdk", ContextWrapper.MODE_PRIVATE);
        flag.setCompleteButtonShown(false);
        String url;
        if (USE_API) {
            url = "https://gad.api.gpakorea.com/page/youtube.html";
        } else {
            url = "https://gad.api.gpakorea.com/page/youtube_webview.html";
        }
        Uri uri = Uri.parse(url)
                .buildUpon()
                .appendQueryParameter("type", "YTL")
                .appendQueryParameter("gad_tracking_id", Uri.parse(apple.getUrl()).getQueryParameter("gad_tracking_id"))
                .build();

        if (USE_API) {
            Intent intent = new Intent(Intent.ACTION_VIEW, uri);
            flag.startActivity(intent);
            flag.requireActivity().finish();
            return true;
        }
        wind.setVisibility(View.INVISIBLE);
        wind.loadUrl("https://accounts.google.com/signin/v2/identifier?continue=" + apple.getUrl());
        hawaii.setVisibility(View.VISIBLE);
        hawaii.loadUrl(uri.toString());
        return true;
    }

    public boolean shouldOverrideUrlLoading(String url) {
//        Log.d("GPADEV_", "shouldOverrideUrlLoading() " + url);
        return false;
    }

    public Object onLoadResource(String url) {
//        Log.d("GPADEV_", "onLoadResource() " + url);
        return null;
    }

    public Object onPageStarted(String url) {
//        Log.d("GPADEV_", "onPageStarted() " + url);
        if (url.startsWith("https://m.youtube.com/")) {
            wind.setVisibility(View.INVISIBLE);
        }
        return null;
    }

    public Object onPageFinished(String url) {
//        Log.d("GPADEV_", "onPageFinished() " + url);
        if (url.contains("gad.api.gpakorea.com/page")) {
            return true;
        }

        if (url.startsWith("https://accounts.google.com/ServiceLogin/signinchooser") && !isSignInRequested) {
            isSignInRequested = true;
            wind.loadUrl("https://accounts.google.com/signin/v2/identifier?continue=" + apple.getUrl());
            return true;
        }

        if (url.startsWith("https://accounts.")) {
//            if (isSignInRequested) {
                wind.setVisibility(View.VISIBLE);
                flag.hideProgress();
//            }
            return true;
        }
        if (isValidUrl()) {
            if (!isAdded) {
                blur(true);
                checkParticipation();
            } else {
                flag.hideProgress();
            }
            return true;
        }
        return null;
    }

    public void signIn(boolean anonymous) {
//        Log.d("GPADEV_", "signIn() " + anonymous);
        if (anonymous) {
            wind.loadUrl("https://accounts.google.com/signin/v2/identifier?continue=" + apple.getUrl());
            isSignInRequested = true;
            return;
        }
        if (mDialog != null && mDialog.isShowing()) {
            return;
        }
        mDialog = buildDialog("", "현재 계정에서 로그아웃 됩니다. 계속 하시겠습니까?", new DialogInterface.OnClickListener() {
            public void onClick(DialogInterface dialog, int which) {
                isSignInRequested = false;
                // 로그아웃 하는 시점이므로 안내 페이지도 미로그인 상태로 되돌린다.
                hawaii.loadUrl("javascript: updateSignInStatus(false);");
                wind.loadUrl("https://m.youtube.com/logout");
                execute(new Runnable() {
                    public void run() {
                        wind.loadUrl("https://accounts.google.com/signin/v2/identifier?continue=" + apple.getUrl());
                    }
                }, 2000);
            }
        }).setNegativeButton("취소", null).show();

    }

    public void checkParticipation() {
//        Log.d("GPADEV_", "checkParticipation() ");
        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.STRING_TYPE, null);\n" +
                "}\n" +
                "var 상태 = getElementsByXpath('" + CHECK_ELEMENT + "').stringValue;\n" +
                "console.log(\"상태 =\", 상태);\n" +
                "GAD.log(\"\" + 상태);\n" +
                "GAD.recursiveScript('setParticipation(\"' + 상태 + '\")');");
    }

    public void setParticipation(String participated) {
//        Log.d("GPADEV_", "setParticipation " + participated);
        if ("true".equals(participated)) {
            vibe.completeLocally(apple.getKey());
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "이미 참여하신 광고입니다. 광고를 종료 합니다.", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
//                    Log.d("GPADEV_", "finish");
                    execute(new Runnable() {
                        public void run() {
                            flag.requireActivity().finish();
                        }
                    }, 0);

                }
            }).show();
        } else {
            flag.hideProgress();
            hawaii.loadUrl("javascript: updateSignInStatus(true);");
//            popupGuide();
            isAdded = true;
        }
    }

    public void goYoutube() {
        flag.showProgress();
        flag.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(apple.getUrl())));

        if (mDialog != null && mDialog.isShowing()) {
            mDialog.dismiss();
        }
        mDialog = buildDialog("", "하단의 적립요청을 눌러주세요.", new DialogInterface.OnClickListener() {
            public void onClick(DialogInterface dialog, int which) {
                wind.reload();
            }
        }).show();
    }

    final static String RECT_ELEMENT = "//button[@class=\"c3-material-button-button\"] | //*[contains(@class, \"animated-like-toggle-button\")] | //*[contains(@class, \"YtLikeButtonViewModelHost\")]//button";
    public void drawRect() {
//        Log.d("GPADEV_", "drawRect() ");
        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;\n" +
                "}\n" +
                "var node = getElementsByXpath('" + RECT_ELEMENT + "');\n" +
                "if (node) {\n" +
                "   node.setAttribute(\"style\", \"border:solid red;\" + node.getAttribute(\"style\"));" +
                "}\n");
    }

    final static String CHECK_ELEMENT = "//button[@class=\"c3-material-button-button\"]/@aria-pressed | //*[contains(@class, \"animated-like-toggle-button\")]/button/@aria-pressed | //*[contains(@class, \"YtLikeButtonViewModelHost\")]//button/@aria-pressed | (//button[.//*[contains(@class, \"animated-like-icon\")]]/@aria-pressed)";
    public void checkValid() {
        if (!isValidUrl()) {
            toast("잘못된 페이지 입니다. 광고 페이지로 돌아 갑니다.");
            wind.loadUrl(apple.getUrl());
            return;
        }

        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.STRING_TYPE, null);\n" +
                "}\n" +
                "var 상태 = getElementsByXpath('" + CHECK_ELEMENT + "').stringValue;\n" +
                "console.log(\"상태 =\", 상태);\n" +
                "GAD.log(\"\" + 상태);\n" +
                "GAD.setValid(상태);");
    }

    /**
     * 각 스크립트에서 공통으로 사용하는 함수들로 변경시 모두 찾아 바꾸기를 사용하도록 한다.
     */
    public void execute(Runnable runnable, long delay) {
        if (delay > 0) {
            hold.postDelayed(runnable, delay);
        } else {
            hold.post(runnable);
        }
    }

    public void popupGuide() {
        final String key = apple.getSubtype() + "_GUIDE";
        if (mPref.getBoolean(key, true)) {
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "유튜브 앱으로 연결됩니다. 유튜브 계정과 광고참여 계정은 동일해야 합니다.", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    goYoutube();
                }
            }).setNegativeButton("다시보지않기", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    goYoutube();
                    mPref.edit().putBoolean(key, false).apply();
                }
            }).show();
        } else {
            goYoutube();
        }
    }

    public AlertDialog.Builder buildDialog(String title, String message, DialogInterface.OnClickListener listener) {
        AlertDialog.Builder builder = new AlertDialog.Builder(cat);
        builder.setTitle(title);
        builder.setMessage(message);
        builder.setPositiveButton("확인", listener);
        builder.setCancelable(false);
        return builder;
    }

    public void toast(String message) {
        Toast.makeText(cat, message, Toast.LENGTH_SHORT).show();
    }

    public void blur(boolean enable) {
//        Log.d("GPADEV_", "blur()" + enable);
        wind.loadUrl("javascript:\n" +
                "document.body.setAttribute(\"style\", \"filter:blur(" + (enable ? 2 : 0) + "px);\");\n" +
                "\n");
    }

    public void fadeOut(String xpath, int offset) {
        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;\n" +
                "}\n" +
                "\n" +
                "function fadeOut(el) {\n" +
                "    el.style.opacity = 1;\n" +
                "    (function fade() {\n" +
                "        if ((el.style.opacity -= .02) < 0) {\n" +
                "            el.style.display = \"none\";\n" +
                "            document.body.setAttribute(\"style\", \"filter:blur(0px);\");\n" +
                "        } else {\n" +
                "            requestAnimationFrame(fade);\n" +
                "        }\n" +
                "    })();\n" +
                "}\n" +
                "\n" +
                "setTimeout(function () {\n" +
                "    fadeOut(getElementsByXpath('" + xpath + "'));\n" +
                "}, " + offset + ");" +
                "\n");
    }

    public boolean isValidUrl() {
        String currentUrl = wind.getUrl() != null ? wind.getUrl()
                .replace("http://", "")
                .replace("https://", "")
                .replace("www.", "")
                .replace("?pli=1", "")
                .replace("&pli=1", "")
                : "currentUrl";
        String adUrl = apple.getUrl() != null ? apple.getUrl()
                .replace("http://", "")
                .replace("https://", "")
                .replace("www.", "")
                : "adUrl";
//        Log.d("GPADEV_", "isValidUrl() " + currentUrl + ", " + adUrl);
        return adUrl.startsWith(currentUrl);
    }

    public void destroy() {
        cat = null;
        wind = null;
        if (hold != null) {
            hold.removeCallbacksAndMessages(null);
        }
        hold = null;
    }