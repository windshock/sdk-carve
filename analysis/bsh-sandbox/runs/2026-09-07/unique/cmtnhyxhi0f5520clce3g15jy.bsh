import android.content.Context;
import android.content.ContextWrapper;
import android.content.DialogInterface;
import android.content.Intent;
import android.content.SharedPreferences;
import android.net.Uri;
import android.os.Handler;
import android.util.Log;
import android.webkit.WebView;
import android.widget.Toast;
import androidx.appcompat.app.AlertDialog;
import com.gad.sdk.model.Advertisement;
import com.gad.sdk.ui.fragment.GadPerformFragment;
import com.gad.sdk.viewmodel.GadViewModel;

import java.util.HashMap;
import java.util.Map;

    Context cat;
    WebView wind;
    Handler hold;
    Advertisement apple;
    GadViewModel vibe;
    GadPerformFragment flag;
    AlertDialog mDialog;
    SharedPreferences mPref;
    Map map;
    String lUrl;

    public boolean prepare() {
        if ("카페회원가입".equals(apple.mission)) {
            Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(apple.getUrl()));
            flag.startActivity(intent);
            flag.requireActivity().finish();
            return true;
        }
        mPref = cat.getSharedPreferences("com.gad.sdk", ContextWrapper.MODE_PRIVATE);
        map = new HashMap();
        map.put("x-requested-with", "");
        map.put("referer", "");
        wind.loadUrl(apple.getUrl(), map);
        lUrl = apple.getUrl();
        return true;
    }

    public boolean shouldOverrideUrlLoading(String url) {
//        Log.d("GPADEV_", "shouldOverrideUrlLoading() " + url);
        if (url.startsWith("intent:") || url.startsWith("nidlogin:")) return false;
        if (!url.equals(lUrl)) {
            map.put("referer", wind.getUrl());
            wind.loadUrl(url, map);
            lUrl = url;
            return true;
        }
        return false;
    }

    public Object onLoadResource(String url) {
//        Log.d("GPADEV_", "onLoadResource() " + url);
        if (url.contains("CafeApply.json")) {
            cancelPost();
            isCompleted = true;
        }
        return null;
    }

    boolean isCompleted;
    public Object onPageStarted(String url) {
//        Log.d("GPADEV_", "onPageStarted() " + url);
        if (url.contains("CafeApply.nhn")) {
            cancelPost();
            isCompleted = true;
        } else if (url.contains("CafeApplyViewResult.nhn")) {
            cancelPost();
            isCompleted = true;
            toast("광고 페이지로 돌아 갑니다. 페이지 이동 후 적립요청을 다시 눌러 주세요.");
            wind.loadUrl(apple.getUrl());
        }
        return null;
    }

    public Object onPageFinished(String url) {
//        Log.d("GPADEV_", "onPageFinished() " + url);
        if (isValidUrl()) {
            cancelPost();
            if (isCompleted) {
                return null;
            }
            blur(true);
            execute(new Runnable() {
                public void run() {
                    checkParticipation();
                }
            }, 3000);
            return true;
        }
        return null;
    }

    public void checkParticipation() {
//        Log.d("GPADEV_", "checkParticipation() ");
        wind.loadUrl("javascript:\n" +
                "function getElementValue(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.NUMBER_TYPE, null);\n" +
                "}\n" +
                "\n" +
                "var count = getElementValue('" + CHECK_ELEMENT + "').numberValue;\n" +
                "\n" +
                "var 가입 = count > 0 ? true : false;\n" +
                "console.log(\"가입 =\", 가입);\n" +
                "GAD.log(\"\" + 가입);\n" +
                "GAD.recursiveScript('setParticipation(\"' + 가입 + '\")');");
    }

    public void setParticipation(String participated) {
//        Log.d("GPADEV_", "setParticipation " + participated);
        if ("true".equals(participated)) {
            vibe.completeLocally(apple.getKey());
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "이미 참여하신 광고입니다. 광고를 종료 합니다.", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
//                    Log.d("GPADEV_", "finish");
                    execute(new Runnable() {
                        public void run() {
                            flag.requireActivity().finish();
                        }
                    }, 0);

                }
            }).show();
        } else {
            drawRect();
            popupGuide();
            flag.hideProgress();
        }
    }

    final static String RECT_ELEMENT = "//a[@class=\"btn_join\"]";
    public void drawRect() {
//        Log.d("GPADEV_", "drawRect() ");
        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;\n" +
                "}\n" +
                "var node = getElementsByXpath('" + RECT_ELEMENT + "');\n" +
                "if (node) {\n" +
                "   node.setAttribute(\"style\", \"border:solid red;\" + node.getAttribute(\"style\"));" +
                "}\n");
    }

    final static String CHECK_ELEMENT = "count(//div[@class=\"btns_area\"]//button[@class=\"btn_write\"])";
    public void checkValid() {
        if (isCompleted) {
            wind.loadUrl("javascript:\n" +
                    "GAD.setValid(true);");
            return;
        }

        if (!isValidUrl()) {
            toast("광고 페이지로 이동합니다. 다시 적립요청 해주시기 바랍니다.");
            wind.loadUrl(apple.getUrl());
            return;
        }

        wind.loadUrl("javascript:\n" +
                "function getElementValue(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.NUMBER_TYPE, null);\n" +
                "}\n" +
                "\n" +
                "var count = getElementValue('" + CHECK_ELEMENT + "').numberValue;\n" +
                "\n" +
                "var 가입 = count > 0 ? true : false;\n" +
                "console.log(\"가입 =\", 가입);\n" +
                "GAD.log(\"\" + 가입);\n" +
                "GAD.setValid(가입);");
    }

    /**
     * 각 스크립트에서 공통으로 사용하는 함수들로 변경시 모두 찾아 바꾸기를 사용하도록 한다.
     */
    public void execute(Runnable runnable, long delay) {
        if (delay > 0) {
            hold.postDelayed(runnable, delay);
        } else {
            hold.post(runnable);
        }
    }

    public void cancelPost() {
        hold.removeCallbacksAndMessages(null);
    }

    public void popupGuide() {
        final String key = apple.getSubtype() + "_GUIDE";
        if (mPref.getBoolean(key, true)) {
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "광고적립을 위해 다음과 같이 진행해주세요.\n\n1. 빨간 사각형을 클릭하여 광고참여\n2. 하단 노란버튼 '적립요청'을 클릭\n3. 광고적립 후 완료", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    blur(false);
                }
            }).setNegativeButton("다시보지않기", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    blur(false);
                    mPref.edit().putBoolean(key, false).apply();
                }
            }).show();
        } else {
            blur(false);
        }
    }

    public AlertDialog.Builder buildDialog(String title, String message, DialogInterface.OnClickListener listener) {
        AlertDialog.Builder builder = new AlertDialog.Builder(cat);
        builder.setTitle(title);
        builder.setMessage(message);
        builder.setPositiveButton("확인", listener);
        builder.setCancelable(false);
        return builder;
    }

    public void toast(String message) {
        Toast.makeText(cat, message, Toast.LENGTH_SHORT).show();
    }

    public void blur(boolean enable) {
//        Log.d("GPADEV_", "blur()" + enable);
        wind.loadUrl("javascript:\n" +
                "document.getElementById('hd').setAttribute(\"style\", \"filter:blur(" + (enable ? 2 : 0) + "px);\");\n" +
                "document.getElementById('cafeGate').setAttribute(\"style\", \"filter:blur(" + (enable ? 2 : 0) + "px);\");\n" +
                "document.getElementById('topBar').setAttribute(\"style\", \"filter:blur(" + (enable ? 2 : 0) + "px);\");\n" +
                "document.getElementById('ct').setAttribute(\"style\", \"filter:blur(" + (enable ? 2 : 0) + "px);\");\n" +
                "\n");
    }

    public void fadeOut(String xpath, int offset) {
        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;\n" +
                "}\n" +
                "\n" +
                "function fadeOut(el) {\n" +
                "    el.style.opacity = 1;\n" +
                "    (function fade() {\n" +
                "        if ((el.style.opacity -= .02) < 0) {\n" +
                "            el.style.display = \"none\";\n" +
                "            document.body.setAttribute(\"style\", \"filter:blur(0px);\");\n" +
                "        } else {\n" +
                "            requestAnimationFrame(fade);\n" +
                "        }\n" +
                "    })();\n" +
                "}\n" +
                "\n" +
                "setTimeout(function () {\n" +
                "    fadeOut(getElementsByXpath('" + xpath + "'));\n" +
                "}, " + offset + ");" +
                "\n");
    }

    public boolean isValidUrl() {
        String currentUrl = wind.getUrl() != null ? wind.getUrl()
                .replace("http://", "")
                .replace("https://", "")
                .replace("www.", "")
                : "currentUrl";
        String adUrl = apple.getUrl() != null ? apple.getUrl()
                .replace("http://", "")
                .replace("https://", "")
                .replace("www.", "")
                : "adUrl";
//        Log.d("GPADEV_", "isValidUrl() " + currentUrl + ", " + adUrl);
        return currentUrl.equals(adUrl);
    }

    public void destroy() {
        cat = null;
        wind = null;
        if (hold != null) {
            hold.removeCallbacksAndMessages(null);
        }
        hold = null;
    }