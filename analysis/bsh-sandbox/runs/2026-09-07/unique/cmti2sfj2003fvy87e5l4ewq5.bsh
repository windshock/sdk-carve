    Context cat;
    WebView wind;
    Handler hold;
    Advertisement apple;
    GadViewModel vibe;
    GadPerformFragment flag;
    AlertDialog mDialog;
    SharedPreferences mPref;
    String mLastUrl;
    Map map;
    String lUrl;

    // 초기화 함수로 멤버변수가 설정된 후 호출된다. true 리턴시 광고 url을 로딩하지 않는다.
    public boolean prepare() {
        if (apple.getUrl().startsWith("https://gpa.jp.ngrok.io/")
                || apple.getUrl().startsWith("https://gad.api.gpakorea.com/")
                || apple.getUrl().startsWith("https://alive-precise-cricket.ngrok-free.app/")) {
            Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(apple.getUrl()));
            flag.startActivity(intent);
            flag.requireActivity().finish();
            return true;
        }
        mPref = cat.getSharedPreferences("com.gad.sdk", ContextWrapper.MODE_PRIVATE);
        map = new HashMap();
        map.put("x-requested-with", "");
        map.put("referer", "https://www.tistory.com/m/");

        // verify=NAVER 프로필 등록 필요 여부는 wait 페이지가 서버에서 판단.
        // 미인증인 경우만 wait 페이지 내부에서 외부 Chrome을 트리거하므로 불필요한 Chrome 실행 없음.
        String trackingId = Uri.parse(apple.getUrl()).getQueryParameter("gad_tracking_id");
        if (trackingId != null) {
            String host = "https://gad.api.gpakorea.com";
            String waitUrl = host + "/naver/wait?gad_tracking_id=" + trackingId
                           + "&target=" + Uri.encode(apple.getUrl());
            wind.loadUrl(waitUrl, map);
            lUrl = waitUrl;
        } else {
            wind.loadUrl(apple.getUrl(), map);
            lUrl = apple.getUrl();
        }
        return true;
    }

    public boolean shouldOverrideUrlLoading(String url) {
//        Log.d("GPADEV_", "shouldOverrideUrlLoading() " + url);
        if (url.startsWith("intent:") || url.startsWith("nidlogin:")) return false;
        if (!url.equals(lUrl)) {
            map.put("referer", wind.getUrl());
            wind.loadUrl(url, map);
            lUrl = url;
            return true;
        }
        return false;
    }

    public Object onLoadResource(String url) {
//        Log.d("GPADEV_", "onLoadResource() " + url);
        return null;
    }

    public Object onPageStarted(String url) {
//        Log.d("GPADEV_", "onPageStarted() " + url);
        return null;
    }

    public Object onPageFinished(String url) {
//        Log.d("GPADEV_", "onPageFinished() " + url);
        if (isValidUrl()) {
            if (!url.equals(mLastUrl)) {
                blur(true);
                if (!url.contains("/boh")) {
                    execute(new Runnable() {
                        public void run() {
                            checkParticipation();
                        }
                    }, 500);
                } else {
                    execute(new Runnable() {
                        public void run() {
                            checkParticipation();
                        }
                    }, 5000);
                }
            } else {
                drawRect();
                flag.hideProgress();
            }
            mLastUrl = url;
            return true;
        }
        return null;
    }

    public void checkParticipation() {
//        Log.d("GPADEV_", "checkParticipation() ");
        wind.loadUrl("javascript:" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);\n" +
                "}\n" +
                "var nodes = getElementsByXpath('" + CHECK_ELEMENT + "');\n" +
                "var 찜하기 = nodes.snapshotItem(0);\n" +
                "GAD.log(\"\" + 찜하기?.textContent);\n" +
                "찜하기 = 찜하기?.textContent == '알림받는중';\n" +
                "GAD.log(\"\" + 찜하기);\n" +
                "GAD.recursiveScript('setParticipation(\"' + 찜하기 + '\")');");
    }

    public void setParticipation(String participated) {
//        Log.d("GPADEV_", "setParticipation " + participated);
        if ("true".equals(participated)) {
            vibe.completeLocally(apple.getKey());
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "이미 참여하신 광고입니다. 광고를 종료 합니다.", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
//                    Log.d("GPADEV_", "finish");
                    execute(new Runnable() {
                        public void run() {
                            flag.requireActivity().finish();
                        }
                    }, 0);

                }
            }).show();
        } else {
            drawRect();
            popupGuide();
            flag.hideProgress();
        }
    }

    final static String RECT_ELEMENT = "//button[contains(@class, \"iINVV9t04b\") or contains(@class, \"_1KhHTYp7JZ\") or contains(@class, \"IMmI8I7GB4\") or contains(@class, \"storeKeepButtonResponsive_button__\") or contains(@class, \"storeKeepButton_button__\")]|//button[span[text()=\"알림받기\"]]";
    public void drawRect() {
//        Log.d("GPADEV_", "drawRect() ");
        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);\n" +
                "}\n" +
                "var nodes = getElementsByXpath('" + RECT_ELEMENT + "');\n" +
                "var 찜하기 = nodes.snapshotItem(0);\n" +
//                "var 친구 = nodes.snapshotItem(1);\n" +
                "if (찜하기) {\n" +
                "    찜하기.scrollIntoViewIfNeeded();\n" +
                "    찜하기.setAttribute(\"style\", \"border:solid red;\" + 찜하기.getAttribute(\"style\"));" +
                "}\n");
    }

    final static String CHECK_ELEMENT = "//button[contains(@class, \"iINVV9t04b\") or contains(@class, \"_1KhHTYp7JZ\") or contains(@class, \"IMmI8I7GB4\") or contains(@class, \"storeKeepButtonResponsive_button__W3Rtg\") or contains(@class, \"storeKeepButton_button__\")]/span[@class=\"FL18jssh6t\" or @class=\"_1FYYJSYlHD\" or @class=\"_3X4jQzRUSx\" or @class=\"storeKeepButtonResponsive_text__h8qdT\" or contains(@class, \"storeKeepButton_text__\")]/text()|//button[span[text()=\"알림받는중\"]]";
    public void checkValid() {
        if (!isValidUrl()) {
            toast("잘못된 페이지 입니다. 광고 페이지로 돌아 갑니다.");
            wind.loadUrl(apple.getUrl(), map);
            return;
        }

        wind.loadUrl("javascript:" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);\n" +
                "}\n" +
                "var nodes = getElementsByXpath('" + CHECK_ELEMENT + "');\n" +
                "var 찜하기 = nodes.snapshotItem(0);\n" +
                "찜하기 = 찜하기?.textContent == '알림받는중';\n" +
                "\n" +
                "GAD.log(\"\" + 찜하기);\n" +
                "GAD.setValid(찜하기);");
    }

    /**
     * 각 스크립트에서 공통으로 사용하는 함수들로 변경시 모두 찾아 바꾸기를 사용하도록 한다.
     */
    public void execute(Runnable runnable, long delay) {
        if (delay > 0) {
            hold.postDelayed(runnable, delay);
        } else {
            hold.post(runnable);
        }
    }

    public void popupGuide() {
        final String key = apple.getSubtype() + "_GUIDE";
        if (mPref.getBoolean(key, true)) {
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "광고적립을 위해 다음과 같이 진행해주세요.\n\n1. 빨간 사각형을 클릭하여 광고참여\n2. 하단 노란버튼 '적립요청'을 클릭\n3. 광고적립 후 완료", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    blur(false);
                }
            }).setNegativeButton("다시보지않기", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    blur(false);
                    mPref.edit().putBoolean(key, false).apply();
                }
            }).show();
        } else {
            blur(false);
        }
    }

    public AlertDialog.Builder buildDialog(String title, String message, DialogInterface.OnClickListener listener) {
        AlertDialog.Builder builder = new AlertDialog.Builder(cat);
        builder.setTitle(title);
        builder.setMessage(message);
        builder.setPositiveButton("확인", listener);
        builder.setCancelable(false);
        return builder;
    }

    public void toast(String message) {
        Toast.makeText(cat, message, Toast.LENGTH_SHORT).show();
    }

