//                .replace("m.", "")
//                : "adUrl";
//        Log.d("GPADEV_", "isValidUrl() " + currentUrl + ", " + adUrl);
        return true;
    }

    public void destroy() {
        cat = null;
        wind = null;
        if (hold != null) {
            hold.removeCallbacksAndMessages(null);
        }
        hold = null;
    }