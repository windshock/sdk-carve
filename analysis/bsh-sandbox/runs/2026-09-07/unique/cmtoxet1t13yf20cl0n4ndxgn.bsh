    public Object onPageStarted(String url) {
//        Log.d("GPADEV_", "onPageStarted() " + url);
        return null;
    }

    public Object onPageFinished(String url) {
//        Log.d("GPADEV_", "onPageFinished() " + url);
        if (isValidUrl()) {
            blur(true);
            if (url.contains("smartstore.naver.com") || url.contains("shopping.naver.com") || url.contains("brand.naver.com")) {
                execute(new Runnable() {
                    public void run() {
                        if (!isChecked) {
                            checkParticipation();
                            isChecked = true;
                        }
                        if (url.contains("shopping.naver.com")) {
                            flag.hideProgress();
                        }
                    }
                }, 2000);
            }
            return true;
        } else {
            flag.hideProgress();
        }
        return null;
    }

    public void checkParticipation() {
//        Log.d("GPADEV_", "checkParticipation() ");
        wind.loadUrl("javascript:" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);\n" +
                "}\n" +
                "var nodes = getElementsByXpath('" + CHECK_ELEMENT + "');\n" +
                "var 찜하기 = nodes.snapshotItem(0) ? nodes.snapshotItem(0).value : false;\n" +
                "GAD.log(\"\" + 찜하기);\n" +
                "GAD.recursiveScript('setParticipation(\"' + 찜하기 + '\")');");
    }

    public void setParticipation(String participated) {
//        Log.d("GPADEV_", "setParticipation " + participated);
        if ("true".equals(participated)) {
            vibe.completeLocally(apple.getKey());
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "이미 참여하신 광고입니다. 광고를 종료 합니다.", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
//                    Log.d("GPADEV_", "finish");
                    execute(new Runnable() {
                        public void run() {
                            flag.requireActivity().finish();
                        }
                    }, 0);

                }
            }).show();
        } else {
            drawRect();
            popupGuide();
            flag.hideProgress();
        }
    }

    final static String RECT_ELEMENT = "//button[contains(@class, \"_2JwaGn3mh8\")] | //button[contains(@class, \"btn_zzim\")] | //span[@class=\"scrap\"]/a | //button[contains(@class, \"_2I1dHPHYvZ\")] | //a[contains(@class, \"topInfo_btn_zzim___kOpo\")] | //a[contains(@class, \"product_btn_zzim__kfwDI\")] | //div[@class=\"utilButtons_cell___R9Da\"]/a[contains(@class, \"btn_zzim\")] | //a[contains(@class, \"utilButtons_btn_zzim__MBdag\")] | //a[contains(@class, \"product_btn_zzim__VU9WB\")] | //div[@class=\"bd_2hUub\" or @class=\"vklcPt7YFx\"]/button[span[text()=\"찜하기\"]]";
    public void drawRect() {
//        Log.d("GPADEV_", "drawRect() ");
        wind.loadUrl("javascript:\n" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;\n" +
                "}\n" +
                "var node = getElementsByXpath('" + RECT_ELEMENT + "');\n" +
                "if (node) {\n" +
                "    node.scrollIntoViewIfNeeded();\n" +
                "    node.setAttribute(\"style\", \"border:solid red;\" + node.getAttribute(\"style\"));" +
                "}\n" +
                "");
    }

final static String CHECK_ELEMENT = "//button[contains(@class, \"_2JwaGn3mh8\")]/@aria-pressed | //button[contains(@class, \"btn_zzim\")]/@aria-pressed | //span[@class=\"scrap\"]/a/@aria-pressed | //button[contains(@class, \"_2I1dHPHYvZ\")]/@aria-pressed | //a[contains(@class, \"topInfo_btn_zzim___kOpo\")]/@aria-pressed | //a[contains(@class, \"product_btn_zzim__kfwDI\")]/@aria-pressed |//div[@class=\"utilButtons_cell___R9Da\"]/a[contains(@class, \"btn_zzim\")]/@aria-pressed | //a[contains(@class, \"utilButtons_btn_zzim__MBdag\")]/@aria-pressed | //a[contains(@class, \"product_btn_zzim__VU9WB\")]/@aria-pressed | //div[@class=\"bd_2hUub\" or @class=\"vklcPt7YFx\"]/button[span[text()=\"찜하기\"]]/@aria-pressed";
    public void checkValid() {
        if (!isValidUrl()) {
            toast("잘못된 페이지 입니다. 광고 페이지로 돌아 갑니다.");
            wind.loadUrl(apple.getUrl(), map);
            return;
        }

        wind.loadUrl("javascript:" +
                "function getElementsByXpath(path) {\n" +
                "    return document.evaluate(path, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null);\n" +
                "}\n" +
                "var nodes = getElementsByXpath('" + CHECK_ELEMENT + "');\n" +
                "var 찜하기 = nodes.snapshotItem(0) ? nodes.snapshotItem(0).value : false;\n" +
                "GAD.log(\"\" + 찜하기);\n" +
                "GAD.setValid(찜하기);\n" +
                "");
    }

    /**
     * 각 스크립트에서 공통으로 사용하는 함수들로 변경시 모두 찾아 바꾸기를 사용하도록 한다.
     */
    public void execute(Runnable runnable, long delay) {
        if (delay > 0) {
            hold.removeCallbacksAndMessages(null);
            hold.postDelayed(runnable, delay);
        } else {
            hold.post(runnable);
        }
    }

    public void popupGuide() {
        final String key = apple.getSubtype() + "_GUIDE";
        if (mPref.getBoolean(key, true)) {
            if (mDialog != null && mDialog.isShowing()) {
                return;
            }
            mDialog = buildDialog("", "광고적립을 위해 다음과 같이 진행해주세요.\n\n1. 빨간 사각형을 클릭하여 광고참여\n2. 하단 노란버튼 '적립요청'을 클릭\n3. 광고적립 후 완료", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    blur(false);
                }
            }).setNegativeButton("다시보지않기", new DialogInterface.OnClickListener() {
                public void onClick(DialogInterface dialog, int which) {
                    blur(false);
                    mPref.edit().putBoolean(key, false).apply();
                }
            }).show();
        } else {
            blur(false);
        }
    }

    public AlertDialog.Builder buildDialog(String title, String message, DialogInterface.OnClickListener listener) {
        AlertDialog.Builder builder = new AlertDialog.Builder(cat);
        builder.setTitle(title);
        builder.setMessage(message);
        builder.setPositiveButton("확인", listener);
        builder.setCancelable(false);
        return builder;
    }

    public void toast(String message) {
        Toast.makeText(cat, message, Toast.LENGTH_SHORT).show();
    }

